{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Authentication": "Debug",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ProductMedia": {
    "StagingBucket": "product-staging",
    "MediaBucket": "product-media",
    "UploadUrlExpirationMinutes": 10,
    "MaxFileSizeBytes": 5242880,
    "MaxImagesPerProduct": 10,
    "PendingUploadExpirationMinutes": 30,
    "CleanupRetentionMinutes": 30,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ]
  },
  "ObjectStorage:S3": {
    "ServiceUrl": "http://localhost:3900",
    "Region": "garage",
    "ForcePathStyle": true
  }
}
